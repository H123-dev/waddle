      "text": "Users : TABLE\n\nproperties:\n\n\nid : \nBIGSERIAL \nPRIMARY KEY \n\nname:\nVARCHAR(256)\nNOT NULL\nUNIQUE\n\nemail:\nVARCHAR(256)\nNOT NULL\nUNIQUE\n\npassword_hash:\nTEXT\nNOT NULL\n\nrole:\nVARCHAR(6)\nCHECK(role = 'Player' or role\n='Admin')\nNOT NULL\n\n\n\n\n\n\n",
